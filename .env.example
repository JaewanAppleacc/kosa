# 이 파일은 변수 이름만 기록한다 (CLAUDE.md: ".env는 커밋하지 않고 .env.example에는
# 변수명만 기록한다"). 실제 값은 .env에 채우고, .env는 절대 커밋하지 않는다.

# --- LLM (§10 질문 생성 — Chat) ---
OPENAI_API_KEY=
OPENAI_CHAT_BASE_URL=
OPENAI_CHAT_MODEL=
# true로 바꿔야 API가 실제 LLM을 호출한다. 비워두면(기본값) Mock 문구를 계속 쓴다 —
# 테스트(unittest discover)가 실수로 진짜 네트워크를 호출하지 않게 하는 안전장치.
ENABLE_LLM_QUESTION_GENERATION=

# --- Embedding (RAG — C 소유 영역, 참고용으로 함께 기록) ---
OPENAI_EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=
# true로 명시해야 실제 Embedding API를 호출한다. API Key가 로컬 .env에 있더라도
# 비워두면 결정론적 HashingEmbedder를 사용해 테스트·데이터 빌드의 외부 호출을 막는다.
ENABLE_OPENAI_EMBEDDING=

# --- Trait Ontology v2 2단계 (신규 Trait Direct Probe, Shadow와 별개 Feature Flag) ---
# true여야 Legacy 검사 종료 후 신규 Trait 확인 질문(최대 4개)이 추가된다. 비워두면
# (기본값) 기존 Legacy 질문 흐름·문항 수·Profile·추천 결과가 완전히 그대로 유지된다.
ENABLE_TRAIT_VECTOR_V2_DIRECT_PROBES=

# --- Trait Ontology v2 2.6단계 (Profile·전공·과목 추천 Primary 입력, 위 Flag와 독립) ---
# true여야 /profile·/majors·/subjects가 v2 TraitVectorSnapshot을 실제 입력으로 쓴다.
# 비워두면(기본값) 기존 Legacy Profile·Matching 결과가 완전히 그대로 유지된다.
ENABLE_TRAIT_VECTOR_V2_PRIMARY=

# --- Trait Ontology v2 2.8단계 (신규 ContextPack Runtime 연결, 위 두 Flag와 독립) ---
# true여야 검수 승인된 신규 Context(business 등)가 /contexts 지원 목록과 실제 질문
# 흐름(Routing/Seed/Direct Probe/Backup)에 들어간다. 비워두면(기본값) 기존
# game/media/school_life 3개와 기존 API 값이 완전히 그대로 유지된다.
ENABLE_CONTEXT_PACK_RUNTIME=

# --- LangSmith (관찰 도구, v1.1 FROZEN 확정) ---
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# scripts/langsmith_smoke_test.py 전용 opt-in. true로 바꾸고 위 두 값을 채운 뒤 그
# 스크립트를 수동 실행할 때만 쓴다 — unittest discover는 이 값과 무관하게 항상
# 실제 네트워크를 호출하지 않는다.
RUN_LANGSMITH_SMOKE_TEST=
