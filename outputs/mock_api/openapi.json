            "title": "Detailed Evidence By Dimension"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "user_id",
          "title",
          "highlights",
          "hashtags",
          "detailed_evidence_by_dimension",
