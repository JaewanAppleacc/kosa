  "components": {
    "schemas": {
      "AnswerRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "question_id": {
            "type": "string",
            "title": "Question Id"
          },
          "selected_option_id": {
            "type": "string",
            "title": "Selected Option Id"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "question_id",
          "selected_option_id"
        ],
        "title": "AnswerRequest"
      },
      "AnswerResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "accepted": {
            "type": "boolean",
            "title": "Accepted"
          },
          "next_action": {
            "type": "string",
            "enum": [
              "NEXT_QUESTION",
              "CONTEXT_COMPLETE",
              "ASSESSMENT_COMPLETE"
            ],
            "title": "Next Action"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "accepted",
          "next_action"
        ],
        "title": "AnswerResponse"
      },
      "Body_upload_course_document_course_upload_post": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "selected_major_id": {
            "type": "string",
            "title": "Selected Major Id",
            "description": "PRE_SURVEY와 동일한 규칙으로 검증되는, 이 업로드가 속할 대표 전공"
          },
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "selected_major_id",
          "file"
        ],
        "title": "Body_upload_course_document_course_upload_post"
      },
      "CareerProfile": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "highlights": {
            "items": {
              "$ref": "#/components/schemas/CareerProfileHighlight"
            },
            "type": "array",
            "title": "Highlights"
          },
          "hashtags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hashtags"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "현재 답변을 바탕으로 만든 요약이며 새로운 경험과 답변에 따라 달라질 수 있습니다."
          },
          "detailed_evidence_by_dimension": {
            "additionalProperties": {
              "items": {
                "$ref": "#/components/schemas/DimensionEvidenceItem"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Detailed Evidence By Dimension"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "user_id",
          "title",
          "highlights",
          "hashtags",
          "detailed_evidence_by_dimension",
          "generated_at"
        ],
        "title": "CareerProfile"
      },
      "CareerProfileHighlight": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "supporting_trait_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supporting Trait Ids"
          }
        },
        "type": "object",
        "required": [
          "text",
