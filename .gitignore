# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environment
.venv/
venv/

# Env / secrets (CLAUDE.md: .env는 커밋하지 않는다)
.env
.env.*
!.env.example

# OS
.DS_Store

# Editors
.vscode/
.idea/

# 대학알리미 수집 원본 (rationale_c/07 §7-14)
# gz는 git 델타 압축이 안 먹어서 재수집할 때마다 전량이 새 blob으로 히스토리에 쌓인다.
# 원본은 각자 수집 스크립트로 재현하고, 재현에 필요한 codes/·manifest만 커밋한다.
data/academyinfo_raw/*/departments.raw.jsonl.gz
data/academyinfo_raw/*/universities.raw.jsonl.gz
data/academyinfo_raw/*/curricula/
data/academyinfo_raw/*/collection_checkpoint.json
data/academyinfo_raw/*/collection_errors.jsonl
# 사람이 data.go.kr에서 내려받는 파일 데이터셋 원본(수 MB). 재현은 다운로드 안내로 한다.
data/academyinfo_raw/file_dataset/
data/academyinfo_work/*/*
# 다만 개수·품질 보고서는 커밋한다 — 대용량이 아니고, 수집 결과를 검토하려면 필요하다
# (A 지시 §11: 수집기·정규화기·코드표·Manifest·Hash/개수 보고서·테스트를 커밋).
!data/academyinfo_work/*/normalization_report.json
!data/academyinfo_work/*/classification_dry_run.json
!data/academyinfo_work/*/year_comparison_report.json
!data/academyinfo_work/*/file_dataset_import_report.json
!data/academyinfo_work/*/review_queue_report.json
# 검토 Queue는 커밋한다. 사람이 처리할 작업 목록이고, 생성 입력(normalized·classification
# 결과)이 .gitignore 대상이라 클론한 사람이 재생성할 수 없기 때문이다. 총 9MB로
# GitHub 파일당 100MB 제한에 한참 못 미치고, JSONL 텍스트라 git 델타 압축도 먹는다
# (gz로 묶으면 크기는 1MB로 줄지만 검토자가 grep·열람을 못 한다).
!data/academyinfo_work/*/duplicate_department_review_queue.jsonl
!data/academyinfo_work/*/classification_review_queue.jsonl
!data/academyinfo_work/*/unmapped_nce_queue.jsonl
!data/academyinfo_work/*/department_url_scope_audit.jsonl
# 야간·원격 제외분. "삭제하지 않았다"의 증빙이라 검토자가 열어볼 수 있어야 한다.
!data/academyinfo_work/*/out_of_recommendation_scope.jsonl
