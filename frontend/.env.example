# API Base URL은 여기 한 곳에서만 관리한다 (README_B: Component마다 주소를 하드코딩하지 않는다).
#
# VITE_API_MODE
#   mock : outputs/mock_api/*.json 정적 응답으로 동작. 서버를 안 띄워도 화면이 끝까지 돈다.
#   live : 실제 FastAPI 호출. dev proxy(/api/* → 127.0.0.1:8000/*)를 통해 나간다.
VITE_API_MODE=mock

# live 모드에서 fetch가 붙는 경로. dev proxy를 쓰므로 기본값은 상대 경로다.
VITE_API_BASE_URL=/api

# dev proxy가 넘길 실제 FastAPI 주소 (vite.config.ts에서만 사용).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# mock 모드에서 각 응답에 넣을 인위적 지연(ms). Loading UI를 확인할 때 쓴다.
VITE_MOCK_LATENCY_MS=250
